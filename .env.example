# Copy to .env for local runs:  node --env-file=.env server/index.js
# In production these are set by your host (see render.yaml).

PORT=3000

# Where the SQLite file lives. On Render use /var/data/omogusii.db (mounted disk).
DB_PATH=./data/omogusii.db

# Signing key for login tokens. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Comma-separated origins allowed to call the API.
# The Android app runs its WebView on https://localhost, so include it.
CORS_ORIGIN=https://localhost,http://localhost,http://localhost:5173

# Build-time only: the backend URL baked into the packaged Android app.
# Leave empty for local/dev (calls stay same-origin).
VITE_API_URL=
